# Base URL of the deployed API Gateway stage, e.g. https://xxxxx.execute-api.us-east-2.amazonaws.com/dev
# Copy this file to .env.local for local development. CI/CD injects the real value at build time
# from the API_BASE_URL repository/environment variable (see .github/workflows/ci-cd.yml).
REACT_APP_API_BASE_URL=https://your-api-id.execute-api.us-east-2.amazonaws.com/dev
